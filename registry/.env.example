# Dillweed Registry — Environment Variables
# Copy this file to .env and edit as needed.
# These can also be exported in your shell or set in your launchd/systemd config.

# HTTP port (default: 9475)
# REGISTRY_PORT=9475

# Deployment mode: authoritative | mirror | local (default: authoritative)
# Mirror mode disables all write endpoints.
# REGISTRY_MODE=authoritative

# Admin token for write endpoints (/register, /revoke, /promote)
# If unset, writes are open — suitable for local dev only.
# Generate a secure token: openssl rand -hex 32
# REGISTRY_ADMIN_TOKEN=your-secure-token-here

# Mirror mode only — set by your sync process after each authoritative pull
# AUTHORITATIVE_SNAPSHOT_TIMESTAMP=2026-04-14T12:00:00.000Z
# AUTHORITATIVE_SIGNATURE_HASH=sha256-hex-of-authoritative-list-response
