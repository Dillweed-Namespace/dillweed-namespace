# Dillweed Anthill™ — Environment Variables
# Copy this file to .env and edit as needed.
# These can also be exported in your shell or set in your launchd/systemd config.

# HTTP port (default: 9476)
# ANTHILL_PORT=9476

# Admin token for signal submission endpoint (/signal)
# If unset, signal submission is open — suitable for local dev only.
# Generate a secure token: openssl rand -hex 32
# Store in macOS Keychain: security add-generic-password -a anthill-admin -s dillweed-anthill -w <token>
# ANTHILL_ADMIN_TOKEN=your-secure-token-here
